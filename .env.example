# This is an example, copy it with your tokens into ".env" file or run installer script

# Discord
DISCORD_TOKEN="your_token_here"

# Ollama
LLM="picked_llm" # preffered to use llms with vision
MAIN_PROMPT="You are shy friendly girl. Talk only in english"
OLLAMA_URL="http://localhost:11434"

# Translation for other languages (better working for not english languages on LLMs with not much B)
TRANSLATE=True # or false
LANG=ru # or other lang
LIBRE_TRANSLATE_URL="http://localhost:5000/"
